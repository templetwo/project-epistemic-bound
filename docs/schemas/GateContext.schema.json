{
  "$defs": {
    "Actor": {
      "enum": [
        "supervisor",
        "subject",
        "operator",
        "reference_monitor",
        "executor",
        "evaluator",
        "scripted_reviewer",
        "fixture"
      ],
      "title": "Actor",
      "type": "string"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "action_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Digest",
          "type": "string"
        },
        "approval_id": {
          "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
          "title": "Approval Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "grant_id": {
          "pattern": "^(grant\\.[a-z0-9][a-z0-9-]{0,62}|grnt_[0-9a-f]{32})$",
          "title": "Grant Id",
          "type": "string"
        },
        "grant_version": {
          "minimum": 1,
          "title": "Grant Version",
          "type": "integer"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/Actor"
        },
        "key_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Key Id",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Nonce",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Policy Version",
          "type": "string"
        },
        "proposal_id": {
          "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "revision_vector": {
          "patternProperties": {
            "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$": {
              "type": "integer"
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "title": "Revision Vector",
          "type": "object"
        },
        "run_id": {
          "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature",
          "type": "string"
        },
        "subject_session_id": {
          "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
          "title": "Subject Session Id",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "proposal_id",
        "action_digest",
        "run_id",
        "subject_session_id",
        "revision_vector",
        "policy_version",
        "grant_id",
        "grant_version",
        "issuer",
        "issued_at",
        "expires_at",
        "nonce",
        "key_id",
        "signature"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Grant": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Constraints",
          "type": "object"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "grant_id": {
          "pattern": "^(grant\\.[a-z0-9][a-z0-9-]{0,62}|grnt_[0-9a-f]{32})$",
          "title": "Grant Id",
          "type": "string"
        },
        "issuer": {
          "$ref": "#/$defs/Actor"
        },
        "policy_version": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Policy Version",
          "type": "string"
        },
        "public_description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Public Description",
          "type": "string"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "resource_ids": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Resource Ids",
          "type": "array"
        },
        "revoked": {
          "default": false,
          "title": "Revoked",
          "type": "boolean"
        },
        "run_id": {
          "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "subject_session_id": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Session Id"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "issuer",
        "run_id",
        "subject_session_id",
        "tool",
        "resource_ids",
        "policy_version",
        "valid_from",
        "expires_at",
        "requires_approval",
        "public_description"
      ],
      "title": "Grant",
      "type": "object"
    },
    "PreactionProtocol": {
      "enum": [
        "observe",
        "require"
      ],
      "title": "PreactionProtocol",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "created",
        "running",
        "waiting_review",
        "paused",
        "completed",
        "declined",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ToolName": {
      "enum": [
        "workspace.list",
        "workspace.read",
        "report.write",
        "fixture.repair",
        "checks.run",
        "handoff.write",
        "commitment.propose",
        "export.send"
      ],
      "title": "ToolName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Constructed from trusted storage, never from model JSON (\u00a78.3).",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Approval"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_revisions": {
      "patternProperties": {
        "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$": {
          "type": "integer"
        }
      },
      "propertyNames": {
        "maxLength": 64
      },
      "title": "Current Revisions",
      "type": "object"
    },
    "grants": {
      "items": {
        "$ref": "#/$defs/Grant"
      },
      "title": "Grants",
      "type": "array"
    },
    "now": {
      "format": "date-time",
      "title": "Now",
      "type": "string"
    },
    "policy_version": {
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
      "title": "Policy Version",
      "type": "string"
    },
    "preaction_present": {
      "title": "Preaction Present",
      "type": "boolean"
    },
    "preaction_protocol": {
      "$ref": "#/$defs/PreactionProtocol"
    },
    "run_id": {
      "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_status": {
      "$ref": "#/$defs/RunStatus"
    },
    "subject_session_id": {
      "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
      "title": "Subject Session Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "subject_session_id",
    "run_status",
    "policy_version",
    "grants",
    "current_revisions",
    "approval",
    "preaction_protocol",
    "preaction_present",
    "now"
  ],
  "title": "GateContext",
  "type": "object"
}
