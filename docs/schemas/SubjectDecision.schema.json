          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "title": "ExportSendCall",
      "type": "object"
    },
    "FinishDecision": {
      "additionalProperties": false,
      "properties": {
        "completion_claim": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Completion Claim",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "const": "finish",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "statement",
        "kind",
        "completion_claim",
        "evidence_refs"
      ],
      "title": "FinishDecision",
      "type": "object"
    },
    "FixtureRepairArgs": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
