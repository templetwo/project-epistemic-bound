{
  "$defs": {
    "ActionDecision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "discriminator": {
            "mapping": {
              "checks.run": "#/$defs/ChecksRunCall",
              "commitment.propose": "#/$defs/CommitmentProposeCall",
              "export.send": "#/$defs/ExportSendCall",
              "fixture.repair": "#/$defs/FixtureRepairCall",
              "handoff.write": "#/$defs/HandoffWriteCall",
              "report.write": "#/$defs/ReportWriteCall",
              "workspace.list": "#/$defs/WorkspaceListCall",
              "workspace.read": "#/$defs/WorkspaceReadCall"
            },
            "propertyName": "tool"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WorkspaceListCall"
            },
            {
              "$ref": "#/$defs/WorkspaceReadCall"
            },
            {
              "$ref": "#/$defs/ReportWriteCall"
            },
            {
              "$ref": "#/$defs/FixtureRepairCall"
            },
            {
              "$ref": "#/$defs/ChecksRunCall"
            },
            {
              "$ref": "#/$defs/HandoffWriteCall"
            },
            {
              "$ref": "#/$defs/CommitmentProposeCall"
            },
            {
              "$ref": "#/$defs/ExportSendCall"
            }
          ],
          "title": "Action"
        },
        "kind": {
          "const": "action",
          "title": "Kind",
          "type": "string"
        },
        "pre_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreActionDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "statement",
        "kind",
        "action"
      ],
      "title": "ActionDecision",
      "type": "object"
    },
    "ChecksRunArgs": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
          "title": "Check Id",
          "type": "string"
        }
      },
      "required": [
        "check_id"
      ],
      "title": "ChecksRunArgs",
      "type": "object"
    },
    "ChecksRunCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/ChecksRunArgs"
        },
        "claimed_grant_id": {
          "anyOf": [
            {
              "pattern": "^(grant\\.[a-z0-9][a-z0-9-]{0,62}|grnt_[0-9a-f]{32})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Grant Id"
        },
        "tool": {
          "const": "checks.run",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "title": "ChecksRunCall",
      "type": "object"
    },
    "CommitmentKind": {
      "description": "\u00a79.3: an undertaking is not a claim is not a grant.",
      "enum": [
        "undertaking",
        "claim"
      ],
      "title": "CommitmentKind",
      "type": "string"
    },
    "CommitmentProposeArgs": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/CommitmentKind",
          "default": "undertaking"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CommitmentProposeArgs",
      "type": "object"
    },
    "CommitmentProposeCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/CommitmentProposeArgs"
        },
        "claimed_grant_id": {
          "anyOf": [
            {
              "pattern": "^(grant\\.[a-z0-9][a-z0-9-]{0,62}|grnt_[0-9a-f]{32})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Grant Id"
        },
        "tool": {
          "const": "commitment.propose",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "title": "CommitmentProposeCall",
      "type": "object"
    },
    "DeclineDecision": {
      "additionalProperties": false,
      "properties": {
        "continue_authorized_work": {
          "title": "Continue Authorized Work",
          "type": "boolean"
        },
        "kind": {
          "const": "decline",
          "title": "Kind",
          "type": "string"
        },
        "pre_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreActionDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "statement",
        "kind",
        "continue_authorized_work"
      ],
      "title": "DeclineDecision",
      "type": "object"
    },
    "EscalateDecision": {
      "additionalProperties": false,
      "properties": {
        "escalation": {
          "$ref": "#/$defs/EscalationPayload"
        },
        "kind": {
          "const": "escalate",
          "title": "Kind",
          "type": "string"
        },
        "pre_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreActionDeclaration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "statement",
        "kind",
        "escalation"
      ],
      "title": "EscalateDecision",
      "type": "object"
    },
    "EscalationPayload": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Conflict",
          "type": "string"
        },
        "proposal_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Ref"
        },
        "proposed_effect": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "checks.run": "#/$defs/ChecksRunCall",
                  "commitment.propose": "#/$defs/CommitmentProposeCall",
                  "export.send": "#/$defs/ExportSendCall",
                  "fixture.repair": "#/$defs/FixtureRepairCall",
                  "handoff.write": "#/$defs/HandoffWriteCall",
                  "report.write": "#/$defs/ReportWriteCall",
                  "workspace.list": "#/$defs/WorkspaceListCall",
                  "workspace.read": "#/$defs/WorkspaceReadCall"
                },
                "propertyName": "tool"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/WorkspaceListCall"
                },
                {
                  "$ref": "#/$defs/WorkspaceReadCall"
                },
                {
                  "$ref": "#/$defs/ReportWriteCall"
                },
                {
                  "$ref": "#/$defs/FixtureRepairCall"
                },
                {
                  "$ref": "#/$defs/ChecksRunCall"
                },
                {
                  "$ref": "#/$defs/HandoffWriteCall"
                },
                {
                  "$ref": "#/$defs/CommitmentProposeCall"
                },
                {
                  "$ref": "#/$defs/ExportSendCall"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Effect"
        }
      },
      "required": [
        "conflict"
      ],
      "title": "EscalationPayload",
      "type": "object"
    },
    "ExportSendArgs": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "resource_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
          "title": "Resource Id",
          "type": "string"
        },
        "sink_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
          "title": "Sink Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "fields",
        "sink_id"
      ],
      "title": "ExportSendArgs",
      "type": "object"
    },
    "ExportSendCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
