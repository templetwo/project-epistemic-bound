        "repair_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Repair Id",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "expected_revision",
        "repair_id"
      ],
      "title": "FixtureRepairArgs",
      "type": "object"
    },
    "FixtureRepairCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "$ref": "#/$defs/FixtureRepairArgs"
