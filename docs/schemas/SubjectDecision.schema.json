        },
        "resource_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
          "title": "Resource Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ReportStatus"
