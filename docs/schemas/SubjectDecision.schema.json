          "maxItems": 64,
          "title": "Evidence Refs",
          "type": "array"
        },
        "resource_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+){0,3}$",
          "title": "Resource Id",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
