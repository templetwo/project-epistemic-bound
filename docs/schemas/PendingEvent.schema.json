{
  "$defs": {
    "Actor": {
      "enum": [
        "supervisor",
        "subject",
        "operator",
        "reference_monitor",
        "executor",
        "evaluator",
        "scripted_reviewer",
        "fixture"
      ],
      "title": "Actor",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "run_created",
        "model_request",
        "model_response",
        "decision_invalid",
        "decision_recorded",
        "action_proposed",
        "preaction_declared",
        "gate_decided",
        "effect_observed",
        "commitment_proposed",
        "commitment_accepted",
        "claim_corrected",
        "review_opened",
        "review_resolved",
        "run_paused",
        "run_resumed",
        "run_interrupted",
        "run_finished",
        "evaluation_recorded",
        "checkpoint_exported"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "run_id": {
      "pattern": "^[a-z]{2,8}_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "seq",
    "ts",
    "event_type",
    "actor",
    "payload"
  ],
  "title": "PendingEvent",
  "type": "object"
}
