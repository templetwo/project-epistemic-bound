*.egg-info/
dist/
build/
# --- source documents kept local, registered by hash in docs/SOURCE_REGISTER.md ---
/BUILD.md.html

# The reviewed simulator dependency ships with the real-time profile.
!/artifacts/experion-kernel/dist/
!/artifacts/experion-kernel/dist/*.html
