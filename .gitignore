.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.peb/
state/
runs/
/artifacts/*
!/artifacts/experion-kernel/
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.docx
*.pdf
_sources/private/
.DS_Store
