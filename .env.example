# project-epistemic-bound — local operator configuration (example; copy to .env, never commit .env)
# Operator state lives OUTSIDE the checkout by default (BUILD_SPEC §6). Tests always get a temp root.
PEB_STATE_ROOT=~/.local/share/project-epistemic-bound
# Loopback only. No LAN bind (BUILD_SPEC §5, §15.3).
PEB_HOST=127.0.0.1
PEB_PORT=8787
# Local provider: explicit endpoint and explicit model ID. No automatic pull, no fallback (§9.2).
PEB_OLLAMA_ENDPOINT=http://127.0.0.1:11434
PEB_OLLAMA_MODEL=
# Signing mode is fixed for v0.1: development_local_hmac (key generated by the app in the state root, never here).
