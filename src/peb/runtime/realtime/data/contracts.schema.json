                "LIC101",
                "FIC102",
                "TIC201",
                "TIC202",
                "TIC301",
                "LIC401",
                "PIC401",
                "FIC211",
                "TIC212",
                "TIC213",
                "FIC310",
                "TIC311",
                "FIC313",
                "TIC502",
                "LIC503",
                "LIC504",
                "PIC505"
              ]
            },
            "expected_mode": {
