              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
              },
              "minItems": 0,
              "maxItems": 32
            },
            "uncertainty": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "unresolved": {
              "type": "array",
