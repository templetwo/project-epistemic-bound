                    "M3/H",
                    "DEG C",
                    "%",
                    "KPA"
                  ]
                }
              },
              "required": [
                "field",
                "value_milli",
                "unit"
              ]
            }
          },
          "required": [
            "target",
            "expected_mode",
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "LIC101",
                "FIC102",
                "TIC201",
                "TIC202",
                "TIC301",
                "LIC401",
                "PIC401",
                "FIC211",
                "TIC212",
                "TIC213",
                "FIC310",
                "TIC311",
                "FIC313",
                "TIC502",
                "LIC503",
                "LIC504",
                "PIC505"
              ]
            },
            "expected_mode": {
              "type": "string",
              "enum": [
                "MAN",
                "AUTO",
                "CAS"
              ]
            },
            "mode": {
              "const": "MAN"
            },
            "demand": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "const": "OP"
                },
                "value_milli": {
                  "type": "integer",
                  "minimum": -10000000,
                  "maximum": 10000000
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "M3/H",
                    "DEG C",
                    "%",
                    "KPA"
                  ]
                }
              },
              "required": [
                "field",
                "value_milli",
                "unit"
              ]
            }
          },
          "required": [
            "target",
            "expected_mode",
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": "string",
              "enum": [
                "LIC101",
                "FIC102",
                "TIC201",
                "TIC202",
                "TIC301",
                "LIC401",
                "PIC401",
                "FIC211",
                "TIC212",
                "TIC213",
                "FIC310",
                "TIC311",
                "FIC313",
                "TIC502",
                "LIC503",
                "LIC504",
                "PIC505"
              ]
            },
            "expected_mode": {
              "type": "string",
              "enum": [
                "MAN",
                "AUTO",
                "CAS"
              ]
            },
            "mode": {
              "const": "CAS"
            }
          },
          "required": [
            "target",
            "expected_mode",
            "mode"
          ]
        }
      ]
    },
    "Call": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "loop.set"
            },
            "arguments": {
              "$ref": "#/$defs/LoopArgs"
            }
          },
          "required": [
            "operation",
            "arguments"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "alarm.ack"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "alarm_episode_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
                }
              },
              "required": [
                "target",
                "alarm_episode_id"
              ]
            }
          },
          "required": [
            "operation",
            "arguments"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "motor.command"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string",
                  "enum": [
                    "P101",
                    "M202"
                  ]
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "START",
                    "STOP"
                  ]
                }
              },
              "required": [
                "target",
                "command"
              ]
            }
          },
          "required": [
            "operation",
            "arguments"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "sequence.command"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target": {
                  "const": "SCM202"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "START",
                    "HOLD",
                    "RESUME",
                    "ABORT"
                  ]
                },
                "expected_phase": {
                  "type": "string",
                  "enum": [
                    "IDLE",
                    "CHARGE",
                    "HEATUP",
                    "FEED",
                    "REACT",
                    "COOL",
                    "DRAIN"
                  ]
                }
              },
              "required": [
                "target",
                "command",
                "expected_phase"
              ]
            }
          },
          "required": [
            "operation",
            "arguments"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "message.ack"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "message_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.:-]{2,127}$"
                },
                "expected_message_version": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "message_id",
                "expected_message_version"
              ]
            }
          },
          "required": [
            "operation",
            "arguments"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "view.focus"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "view": {
                  "type": "string",
                  "enum": [
                    "U1",
                    "U2",
                    "U3",
                    "U4",
                    "ALARMS",
                    "TRENDS",
                    "BATCH",
                    "PRODUCT",
                    "ARCH"
                  ]
                },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "view"
              ]
            }
          },
          "required": [
            "operation",
            "arguments"
          ]
        }
      ]
    },
    "SubjectDecision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "act"
