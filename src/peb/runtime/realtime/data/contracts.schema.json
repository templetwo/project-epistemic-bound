{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:temple-of-two:peb:rt:v1",
  "title": "PEB live operations proposed transport contracts",
  "description": "Structural contract only. Units, authority, role, time, state applicability, mode ownership, and dynamic limits require trusted runtime validation. PlantCommand is a server-created envelope, never accepted as proof of authentication.",
