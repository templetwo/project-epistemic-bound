        "created_utc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "expires_utc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "call": {
          "$ref": "#/$defs/Call"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
