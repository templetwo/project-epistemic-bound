    "SequenceValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "IDLE",
            "CHARGE",
            "HEATUP",
            "FEED",
            "REACT",
            "COOL",
            "DRAIN"
          ]
