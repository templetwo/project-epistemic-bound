              "maxItems": 32
            },
            "uncertainty": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "call": {
              "$ref": "#/$defs/Call"
            },
            "expected_effect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "check_after_s": {
              "type": "integer",
              "minimum": 5,
              "maximum": 120
            }
          },
          "required": [
            "kind",
            "schema_version",
            "rationale",
            "evidence_refs",
            "uncertainty",
            "call",
