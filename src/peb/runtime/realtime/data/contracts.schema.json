                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 0,
              "maxItems": 32
            }
          },
          "required": [
            "kind",
            "schema_version",
            "rationale",
            "evidence_refs",
            "uncertainty",
            "statement",
            "unresolved"
          ]
        }
      ]
